{
    // https://github.com/Pitan76/Todofile

    // ---- セットアップ ----
    // 初回だけ。Rust は DSP (dsp/) を触るときだけ要る
    "setup": [
        "git submodule update --init",
        "npm install",
        "todo models"
    ],
    // wasm32 ターゲットを入れる (入っていれば何もしない)
    "wasm:setup": "rustup target add wasm32-unknown-unknown",
    // WeVocalSynth の submodule として開発するとき: こちらの pevenmui/ を隠し、隣の ../pevenmui だけを使う
    // (同じものが2か所に見えて、違う方を直さないように)
    "setup:nested": [
        "git submodule deinit -f pevenmui",
        "git sparse-checkout set --no-cone \"/*\" \"!/pevenmui/\""
    ],
    // モデルを public/models/ に置く (取得した配布物は .cache/ に残る)
    "models": "npm run fetch-models",

    // ---- 開発 ----
    "dev": "npm run dev",
    "build": "npm run build",
    "preview": "npm run preview",
    // dsp/ をビルドして src/dsp.wasm を作り直す。DSP を変えたら結果もコミットする
    "wasm": "npm run build:wasm",

    // ---- 確認 ----
    "test": "cargo test --release --manifest-path dsp/Cargo.toml",
    // コミット前にまとめて通す。書き換えはしない
    "check": [
        "todo test",
        "todo build"
    ],

    // ---- リリース ----
    // package.json / package-lock.json を更新し、"bump version x.y.z" でコミットして vx.y.z タグを打つ
    // 作業ツリーがきれいでないと失敗する。最後にコミットとタグを push する
    "bump": "todo bump:patch",
    "bump:patch": [
        "npm version patch -m \"bump version %s\"",
        "git push --follow-tags"
    ],
    "bump:minor": [
        "npm version minor -m \"bump version %s\"",
        "git push --follow-tags"
    ],
    "bump:major": [
        "npm version major -m \"bump version %s\"",
        "git push --follow-tags"
    ]
}
