{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // 隣の pevenmui（WeVocalSynth の submodule として開発するとき）を先に探し、なければ自分の submodule
    "paths": { "pevenmui": ["../pevenmui/src/index.ts", "./pevenmui/src/index.ts"] }
  },
  "include": ["app", "src"]
}
